<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>QDND.ico</ApplicationIcon>
    <AssemblyName>Danny</AssemblyName>
    <RootNamespace>NetSecTool</RootNamespace>
    <Product>Danny ver5.7 - Trợ lý Công nghệ Thông tin</Product>
    <AssemblyTitle>Danny ver5.7 - Trợ lý Công nghệ Thông tin</AssemblyTitle>
    <Company>Bộ Chỉ huy Quân sự tỉnh Lâm Đồng</Company>
    <Version>5.7.0</Version>
    <FileVersion>5.7.0.0</FileVersion>
    <AssemblyVersion>5.7.0.0</AssemblyVersion>
    <!--
      Pin InformationalVersion thu cong de ProductVersion khong bi gan
      hash commit (SDK mac dinh sinh "5.7.0+<sha>"). Neu dung hash, moi
      lan build sau commit se lam metadata bi cu, va phai build lai
      + upload lai asset (mat ~15 phút moi lan).
      Ban nay giu phien ban co dinh -> build bao gio cung dung version.
    -->
    <InformationalVersion>5.7.0</InformationalVersion>
    <!--
      IncludeSourceRevisionInInformationalVersion=false: mac dinh cua .NET SDK
      tu ghep SourceRevisionId (hash commit) vao cuoi InformationalVersion,
      tao ra chuoi dang "5.7.0+<sha>". Tat de ProductVersion luon la
      "5.7.0" co dinh, khong phai rebuild moi khi commit.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Description>Trợ lý Công nghệ Thông tin - Trung tá Đoàn Danh Quyết</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logo: embed de ban single-file van hoat dong -->
    <EmbeddedResource Include="Resources\logo.png">
      <LogicalName>NetSecTool.Resources.logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!--
    KVRT.exe (Kaspersky offline ~114 MB) KHONG embed - dat rieng trong thu muc
    "tools/" de ban phan phoi nhe hon. Neu file khong tim thay, chuc nang nay
    se bao loi ro rang thay vi lam app cham.

    ExcludeFromSingleFile=true: bat buoc, neu khong co thi .NET van nhung
    file nay vao bundle single-file va exe se nang tro lai.
  -->
  <ItemGroup>
    <None Include="Resources\KVRT.exe" Link="tools\KVRT.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <!--
    SetupMiAV.exe (trinh cai dat MiAV 4.1.1.2 cua BTL86, ~21 MB) cung KHONG
    embed - dat rieng trong thu muc "tools/" de ban phan phoi nhe hon va de
    cap nhat duoc khi BTL86 phat hanh phien ban moi.

    Buoc cuoi cung cua chuc nang "Lam sach PC mot cham" se chay trinh cai dat
    nay o che do /VERYSILENT de tao lai 4 service MiAV.
  -->
  <ItemGroup>
    <None Include="Resources\SetupMiAV.exe" Link="tools\SetupMiAV.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TestForm1" />
    <InternalsVisibleTo Include="TestBox" />
    <InternalsVisibleTo Include="ShotV3" />
    <InternalsVisibleTo Include="TestIme" />
    <InternalsVisibleTo Include="TestMouseReal" />
    <InternalsVisibleTo Include="TestImeUnicode" />
    <InternalsVisibleTo Include="TestShotFinal" />
    <InternalsVisibleTo Include="ShotClean" />
  </ItemGroup>

  <!--
    ============================================================
    RUSTDESK 1.5.3 - dung cho chuc nang "Ho tro ky thuat tu xa"
    (tab moi o ver5.6), thay the UltraVNC 1.4.2.0.

    Che do Direct IP Access: ket noi truc tiep qua IP noi bo,
    100% OFFLINE - khong dung ID/Relay Server trung gian.

    Cau truc giu nguyen:
        tools\RustDesk\rustdesk.exe        (RustDesk client 1.5.3 x64)
        tools\RustDesk\server\hbbs.exe    (ID server tu host - tuy chon)
        tools\RustDesk\server\hbbr.exe    (relay server tu host - tuy chon)

    KHONG embed vao exe - giu rieng trong thu muc tools/ de ban
    phan phoi nhe hon va de cap nhat duoc.

    ExcludeFromSingleFile=true: bat buoc, neu khong co thi .NET se dung
    file nay vao bundle single-file va exe se nang tro lai.
  -->
  <ItemGroup>
    <None Include="Resources\RustDesk\**\*"
          Link="tools\RustDesk\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    ============================================================
    VER5.7 - BO QUY TAC FORENSIC (cho tab "KIEM TRA AN TOAN THONG TIN")

    File tools\rules\forensic-rules.json chua bo quy tac phat hien
    Internet trai phep / lo rot tai lieu / anti-forensics. Nguoi dung
    co the sua file nay ma KHONG can build lai phan mem.

    Neu file khong ton tai, phan mem tu dung bo quy tac mac dinh
    hard-code trong Forensic\ForensicModels.cs.
  -->
  <ItemGroup>
    <None Include="Resources\rules\forensic-rules.json" Link="tools\rules\forensic-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
    ============================================================
    VER5.7 - ENGINE ACRO NIS (cho tab "SAO LUU MAY TINH")

    tools\acronis\*.exe KHONG embed trong exe ban phan phoi vi
    ban single-file se tro len rất nang (~120 MB + .NET runtime).
    Nguoi dung dat rieng thu muc tools\acronis\ canh phan mem, hoac
    cai Acronis True Image roi tro duong dan trong giao dien.
  -->
</Project>
